# Grid07 — Environment Variables
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.

# ── LLM Backend (choose one) ───────────────────
# Groq (recommended — fast, free tier available)
# Sign up: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OpenAI (fallback)
# Sign up: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# ── Optional Overrides ─────────────────────────
# Set to 1 to run only Phase 1 (no LLM required)
# SKIP_LLM=0

# Similarity threshold for Phase 1 routing (default: 0.35)
# ROUTER_THRESHOLD=0.35
